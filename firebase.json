{
  "hosting": {
    "target": "cv-generator",
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "trailingSlash": false,
    "headers": [
      {
        "source": "**/*.xml",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/xml; charset=utf-8"
          }
        ]
      },
      {
        "source": "/robots.txt",
        "headers": [
          {
            "key": "Content-Type",
            "value": "text/plain; charset=utf-8"
          }
        ]
      },
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/fonts/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/*.@(html|xml|txt)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/en/blog/:slug",
        "destination": "/blog/:slug",
        "type": 301
      },
      {
        "source": "/en",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/blog/international-resume-tips",
        "destination": "/ar/blog/international-resume-tips",
        "type": 301
      },
      {
        "source": "/blog/resume-skills-guide",
        "destination": "/ar/blog/resume-skills-guide",
        "type": 301
      },
      {
        "source": "/blog/remote-job-success",
        "destination": "/ar/blog/remote-job-success",
        "type": 301
      },
      {
